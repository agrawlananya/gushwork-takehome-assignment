{
  "name": "lead-followup-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply leads-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leads-db --remote"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/groq": "^4.0.61",
    "@date-fns/tz": "^1.5.0",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.2",
    "ai": "^7.0.141",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
